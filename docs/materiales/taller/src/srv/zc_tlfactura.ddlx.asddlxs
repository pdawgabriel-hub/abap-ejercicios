@Metadata.layer: #CORE
@UI.headerInfo: { typeName: 'Factura de subcontrata', typeNamePlural: 'Facturas de subcontrata',
                  title: { value: 'OrdenRef' } }
annotate entity ZC_TlFactura with
{
  // Secciones de la pagina de detalle
  @UI.facet: [
    { id: 'Datos', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Datos', position: 10 }
  ]

  @UI.hidden: true
  FacturaUUID;

  @UI.lineItem: [ { position: 10 } ]
  @UI.identification: [ { position: 10 } ]
  @UI.selectionField: [ { position: 10 } ]
  @UI.textArrangement: #TEXT_ONLY
  OrdenUUID;

  @UI.lineItem: [ { position: 20 } ]
  @UI.identification: [ { position: 20 } ]
  @UI.selectionField: [ { position: 20 } ]
  @UI.textArrangement: #TEXT_ONLY
  SubcontrataUUID;

  @UI.lineItem: [ { position: 30 } ]
  @UI.identification: [ { position: 30 } ]
  Fecha;

  @UI.lineItem: [ { position: 40 } ]
  @UI.identification: [ { position: 40 } ]
  ImporteNeto;

  @UI.lineItem: [ { position: 50 } ]
  @UI.identification: [ { position: 50 } ]
  Liquidado;

  @UI.hidden: true
  OrdenRef;

  @UI.hidden: true
  SubcontrataNombre;
}
