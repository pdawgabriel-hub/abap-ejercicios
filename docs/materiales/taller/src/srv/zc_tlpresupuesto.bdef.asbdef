// Proyeccion: elige que partes del comportamiento de debajo usa la app
projection;
strict ( 2 );
use draft;                       // la app trabaja con borradores
use side effects;                // y publica los side effects de 3.3

define behavior for ZC_TlPresupuesto alias Presupuesto
{
  use create;
  use update;
  use delete;

  // Las acciones del borrador, una a una
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action aceptar;
  use action volverABorrador;
  use action vincularAOrden;
  use action exportarPresupuesto;

  use association _Partidas { create; with draft; }
  use association _Previstos { create; with draft; }
  use association _Notas { create; with draft; }
  use association _Avisos { create; with draft; }
  use association _Fotos { create; with draft; }
}

define behavior for ZC_TlPartida alias Partida
{
  use update;
  use delete;

  use association _Presupuesto { with draft; }
}

define behavior for ZC_TlPresuDis alias Previsto
{
  use update;
  use delete;

  use association _Presupuesto { with draft; }
}

define behavior for ZC_TlPresuNota alias Nota
{
  use update;
  use delete;

  use association _Presupuesto { with draft; }
}

define behavior for ZC_TlPresuAviso alias Aviso
{
  use update;
  use delete;

  use association _Presupuesto { with draft; }
}

define behavior for ZC_TlPresuFoto alias Foto
{
  use update;
  use delete;

  use association _Presupuesto { with draft; }
}
