// Proyeccion: elige que partes del comportamiento de debajo usa la app
projection;
strict ( 2 );
use draft;                       // la app trabaja con borradores
use side effects;                // y publica los side effects de 3.3

define behavior for ZC_TlJornada alias Jornada
{
  use create;
  use update;
  use delete;

  // Las acciones del borrador, una a una
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Tramos { create; with draft; }
}

define behavior for ZC_TlTramo alias Tramo
{
  use update;
  use delete;

  use association _Jornada { with draft; }
}
