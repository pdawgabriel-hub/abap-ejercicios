define behavior for ZI_TlOrdenFoto alias Foto
persistent table ztl_ord_fot
draft table ztl_ord_fot_d
lock dependent by _Orden
authorization dependent by _Orden
etag master LocalLastChangedAt
{
  update;
  delete;

  field ( readonly ) OrdenUUID, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  association _Orden { with draft; }

  // RAP genera el UUID al crear; nadie lo puede cambiar
  field ( numbering : managed, readonly ) FotoUUID;

  // Campo de la vista (izquierda) = columna de la tabla (derecha)
