// Comportamiento del objeto de negocio: que se puede hacer y que se ejecuta solo
managed implementation in class zbp_i_tlfactura unique;
strict ( 2 );
with draft;

define behavior for ZI_TlFactura alias Factura
persistent table ztl_fac
draft table ztl_fac_d
lock master
total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory ) OrdenUUID, SubcontrataUUID, ImporteNeto;

  // 3.4: el importe neto tiene que ser mayor que 0
  validation validarImporte on save { create; field ImporteNeto; }

  // Las acciones del borrador: editar, guardar, descartar, retomar y preparar
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validarImporte;
  }

  // RAP genera el UUID al crear; nadie lo puede cambiar
  field ( numbering : managed, readonly ) FacturaUUID;

  // Campo de la vista (izquierda) = columna de la tabla (derecha)
  mapping for ztl_fac corresponding
  {
    FacturaUUID        = factura_uuid;
    OrdenUUID          = orden_uuid;
    SubcontrataUUID    = subcontrata_uuid;
    Fecha              = fecha;
    ImporteNeto        = importe_neto;
    Liquidado          = liquidado;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
