{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api",
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "Cloud",
    "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)"
  },
  "rules": {
    "parser_error": true,
    "check_syntax": {
      "exclude": [
        "zcl_tl_escucha_abonos.clas.locals_imp.abap"
      ]
    },
    "unknown_types": true,
    "check_ddic": true,
    "cds_parser_error": true,
    "cds_legacy_view": true,
    "cloud_types": true,
    "unused_variables": {
      "skipNames": [
        "requested_authorizations",
        "requested_features",
        "requested_authorization",
        "failed",
        "reported",
        "mapped",
        "result"
      ]
    },
    "check_subrc": false,
    "exporting": false
  }
}